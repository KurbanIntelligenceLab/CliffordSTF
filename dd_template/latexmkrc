# Build manuscript/SI reference data before the selected Overleaf document.
# Standard xr/latexmk workflow: https://www.overleaf.com/learn/how-to/Cross_referencing_with_the_xr_package_in_Overleaf
use File::Copy qw(copy);

for my $document ('main', 'esi', 'main', 'esi') {
    my $status = system('latexmk', '-norc', '-pdf', '-interaction=nonstopmode',
                        '-halt-on-error', '-outdir=.crossrefs', "$document.tex");
    die "Could not build references for $document\n" if $status != 0;
    copy(".crossrefs/$document.aux", "$document.aux")
        or die "Could not copy references for $document: $!\n";
}
